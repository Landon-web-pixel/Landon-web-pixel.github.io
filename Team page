            padding: 20px;
            margin-bottom: 25px;
            min-height: 170px;
            border-radius: 10px;
            overflow: auto;
            box-shadow: 0 2px 6px #aaa;
        

        .member img 
            width: 150px;
            height: 150px;
            object-fit: cover;
            float: left;
            margin-right: 20px;
            border-radius: 50%;
        

        .member h2 
            color: #203b5c;
        

        footer 
            background-color: #203b5c;
            color: white;
            text-align: center;
            padding: 15px;
            position: relative;
        
